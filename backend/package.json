{
  "name": "takuya-kimura-backend",
  "version": "1.0.0",
  "description": "STARTO — Takuya Kimura Official — Production API (Postgres + R2 + Stripe + Email)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --env-file=.env server.js",
    "start": "node server.js",
    "migrate": "psql $DATABASE_URL -f ../database/schema.sql",
    "seed:dev": "psql $DATABASE_URL -f ../database/seed.dev.sql",
    "test": "node --test",
    "optimize:images": "node scripts/optimize-images.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "pg-format": "^1.0.4",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^14.25.0",
    "aws-sdk": "^2.1580.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-presigned-post": "^3.620.0",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "sharp": "^0.33.4",
    "nodemailer": "^6.9.14",
    "zod": "^3.23.8",
    "rate-limiter-flexible": "^3.0.8",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
