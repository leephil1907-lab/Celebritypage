# =============================================================================
# TAKUYA KIMURA — Production Env (copy to .env, never commit secrets)
# =============================================================================
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://takuya:__CHANGE_ME__@db:5432/takuya_prod?sslmode=require
# Use pgbouncer if available: postgres://...
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=__CHANGE_32+_RANDOM__
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# R2 / S3 — Cloudflare R2 (S3-compatible) for hero/news/film/release + product assets
R2_ACCOUNT_ID=__CLOUDFLARE_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__R2_ACCESS_KEY__
R2_SECRET_ACCESS_KEY=__R2_SECRET__
R2_BUCKET=takuya-kimura-prod
R2_PUBLIC_BASE=https://assets.takuya-kimura.jp
# Also S3 fallback
S3_BUCKET=takuya-kimura-prod
AWS_REGION=ap-northeast-1

# Stripe — Production payments (no raw card storage, webhook-verified)
STRIPE_SECRET_KEY=sk_live___REPLACE__
STRIPE_WEBHOOK_SECRET=whsec___REPLACE__
STRIPE_PUBLISHABLE_KEY=pk_live___REPLACE__
# 5140 yen flow (入会金1000 + 年会費4000 + 事務手数料140) — single Stripe Price
STRIPE_JOIN_PRICE_ID=price_1__5140YEN__
# Konbini & PayPay via Stripe (konbini, paypay) — enable in Dashboard
# Pay-easy is via Stripe? For Pay-easy use separate provider (VeriTrans/GMO) — webhook below
PAYPAY_API_KEY=
KONBINI_PROVIDER=gmo

# Email — fc-member.familyclub.jp allowlist + real delivery
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.__REPLACE__
EMAIL_FROM="Takuya Kimura Official <no-reply@takuya-kimura.jp>"
EMAIL_REPLY_TO="support@takuya-kimura.jp"
# Allowlist — only these domains may receive join mail (prevents abuse)
EMAIL_ALLOWLIST=fc-member.familyclub.jp,gmail.com,icloud.com,yahoo.co.jp,softbank.jp,docomo.ne.jp,ezweb.ne.jp
# Bounce handling

# SEO
SITE_URL=https://takuya-kimura.jp
# i18n — approved translations only (ja primary, en secondary, ko/zh future via CMS)
DEFAULT_LOCALE=ja

# Security
CORS_ORIGIN=https://takuya-kimura.jp,https://www.takuya-kimura.jp
RATE_LIMIT_LOGIN=5,  # per 15 min
RATE_LIMIT_CHAT=20 # per min

# Logging
LOG_LEVEL=info
