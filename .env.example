# Copy to .env (never committed) or set these in your host's dashboard.
# Every variable the code reads is listed here, one per line — `npm run check` fails if one is
# missing, if this file documents a variable nothing reads, or if a secret is pre-filled.

# ---------- listeners ----------
PORT=8000                 # public site
ADMIN_PORT=8001           # console, when COMBINED is not set
HOST=0.0.0.0              # bind address. Keep 0.0.0.0 in containers
COMBINED=                 # 1 = serve the console at /admin on the site's own port (one listener)

# ---------- where state lives ----------
DATA_DIR=                 # default ./data — SQLite file, WAL and .key. Put this on a real disk
UPLOAD_DIR=               # default ./uploads — uploaded media. Same rule
DB_FILE=                  # default <DATA_DIR>/celebrity.db; :memory: works for throwaway runs
TMPDIR=                   # only read when DATA_DIR/UPLOAD_DIR are not writable (falls back to <TMPDIR>/starto-celebritypage)

# ---------- identity of the deployment ----------
SITE_URL=                 # https://your-domain — absolute canonical/OG/sitemap/hreflang. Empty follows the request host
BUILD_ID=                 # optional override for the cache-busting token written to public/build.json
NODE_ENV=production       # production also flips Secure cookies and locks the demo accounts

# ---------- who can sign in ----------
ADMIN_EMAIL=              # default admin@starto.jp
ADMIN_PASSWORD=           # REQUIRED in production. Authoritative on every boot, not just the first
SEED_DEMO_PASSWORD=       # set to allow the seeded member accounts (aiko|marc|yuki@example.com) to sign in

# ---------- gates and harnesses (nothing here is read while serving a request) ----------
AUDIT_BASE=               # default http://127.0.0.1:8000 — where npm run audit looks for the site
AUDIT_VERBOSE=            # 1 = print every audit check, not just the failures
AUDIT_ALLOW_NO_BROWSER=   # 1 = let the audit pass without a browser. The only way to pass it that way
CHECK_BASE=               # default http://127.0.0.1:8000 — used by the live route sweep in npm run check
CHECK_VERBOSE=            # 1 = print each integrity check as it runs
QA_BASE=                  # default http://127.0.0.1:8000 — where npm run qa drives the site
QA_ADMIN=                 # default http://127.0.0.1:8001 — same, for the console
QA_ALLOW_NO_BROWSER=      # 1 = let the browser suite pass without Chromium. The only way to pass it that way
TEST_PORT=                # default 8100+ — the port the e2e tests boot their own server on
TEST_ADMIN_PORT=          # default 8101+ — its console port
TEST_BOOT_MARK=           # a string the boot line and /healthz echo, so a test can prove which process answered
TEST_VERBOSE=             # 1 = keep the test server's stdout in the run
