# Copy to .env.local (Next.js) or .env (docker-compose)
# Never commit real secrets.

# Database
DATABASE_URL=postgres://kimura:kimura_secret@localhost:5432/kimura_dev?sslmode=disable
DIRECT_URL=postgres://kimura:kimura_secret@localhost:5432/kimura_dev?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=replace_with_32+_random_chars
NEXTAUTH_URL=http://localhost:3000
ENCRYPTION_KEY=replace_with_32_byte_base64_key__for_pgp_sym_encrypt

# Storage (S3 or Cloudflare R2)
S3_BUCKET=kimura-assets-dev
S3_REGION=auto
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
CLOUDFLARE_R2_PUBLIC_URL=https://assets.dev.takuya-kimura.jp

# Payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_SILVER=price_...
STRIPE_PRICE_GOLD=price_...
STRIPE_PRICE_PLATINUM=price_...
STRIPE_PRICE_DIAMOND=price_...
PAYPAY_API_KEY=...
PAYPAY_API_SECRET=...
PAYPAY_MERCHANT_ID=...

# Email
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@takuya-kimura.jp

# OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
APPLE_CLIENT_ID=...
APPLE_CLIENT_SECRET=...
LINE_CLIENT_ID=...
LINE_CLIENT_SECRET=...

# Observability
SENTRY_DSN=...
NEXT_PUBLIC_POSTHOG_KEY=...
