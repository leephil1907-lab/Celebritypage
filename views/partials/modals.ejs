<% /* Member modal (signup / login / dashboard), vault modal and the cart drawer — all server-primed, all API-driven. */ %>
<div class="modal" id="memberModal" role="dialog" aria-modal="true" aria-labelledby="memberTitle">
  <div class="modal-card">
    <div class="modal-head">
      <b id="memberTitle" style="letter-spacing:.08em;font-size:12px"><%= lang === 'ja' ? 'メンバーアクセス' : 'MEMBER ACCESS' %></b>
      <button type="button" class="icon-btn" data-close-modal="memberModal" style="width:32px;height:32px" aria-label="Close">✕</button>
    </div>
    <div class="modal-body">
      <div class="tabs" role="tablist">
        <button type="button" class="m-tab is-active" data-tab="signup" role="tab"><%= t('cta.signup') %></button>
        <button type="button" class="m-tab" data-tab="login" role="tab"><%= t('cta.login') %></button>
        <button type="button" class="m-tab" data-tab="dashboard" role="tab"><%= t('cta.dashboard') %></button>
      </div>

      <div class="m-pane is-active" id="pane-signup" role="tabpanel">
        <div class="form-msg" id="signupMsg"></div>
        <form class="m-form" data-action="signup" data-msg="signupMsg">
          <div class="field"><label for="suName"><%= lang === 'ja' ? 'お名前' : 'Full name' %></label><input id="suName" name="name" autocomplete="name" placeholder="Your name" required></div>
          <div class="field" style="margin-top:10px"><label for="suEmail"><%= lang === 'ja' ? 'メール' : 'Email' %></label><input id="suEmail" name="email" type="email" autocomplete="email" placeholder="you@example.com" required></div>
          <div class="field" style="margin-top:10px"><label for="suPass"><%= lang === 'ja' ? 'パスワード（8文字以上）' : 'Password (8+ chars)' %></label><input id="suPass" name="password" type="password" autocomplete="new-password" placeholder="••••••••" minlength="8" required></div>
          <button class="btn primary" type="submit" style="width:100%;margin-top:14px"><%= lang === 'ja' ? 'アカウント作成 →' : 'Create Account →' %></button>
          <p class="fineprint"><%= lang === 'ja' ? '登録は無料 — サイトを回ってから Fan Card を選びます。' : 'Free signup — tour the site, then choose your Fan Card.' %></p>
        </form>
      </div>

      <div class="m-pane" id="pane-login" role="tabpanel">
        <div class="form-msg" id="loginMsg"></div>
        <form class="m-form" data-action="login" data-msg="loginMsg">
          <div class="field"><label for="liEmail"><%= lang === 'ja' ? 'メール' : 'Email' %></label><input id="liEmail" name="email" type="email" autocomplete="username" required></div>
          <div class="field" style="margin-top:10px"><label for="liPass"><%= lang === 'ja' ? 'パスワード' : 'Password' %></label><input id="liPass" name="password" type="password" autocomplete="current-password" required></div>
          <button class="btn primary" type="submit" style="width:100%;margin-top:14px"><%= lang === 'ja' ? 'ログイン →' : 'Login →' %></button>
        </form>
      </div>

      <div class="m-pane" id="pane-dashboard" role="tabpanel">
        <div id="dashBody"><div class="loading"><%= lang === 'ja' ? 'ダッシュボード読み込み中…' : 'Loading your dashboard…' %></div></div>
        <h4 class="dash-h4"><%= t('lbl.tickets') %></h4>
        <div id="dashTickets" class="dash-tickets"><div class="loading">—</div></div>
        <div class="dash-actions">
          <button type="button" class="btn ghost small" id="logoutBtn"><%= t('cta.logout') %></button>
          <a class="btn primary small" href="/members/"><%= lang === 'ja' ? 'メンバーページ →' : 'Full member page →' %></a>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal" id="vaultModal" role="dialog" aria-modal="true" aria-labelledby="vaultTitle" style="z-index:102">
  <div class="modal-card" style="max-width:720px;background:#0a0a0a;color:#fff;border-color:#222">
    <div class="modal-head" style="background:#0a0a0a;border-color:#222">
      <b id="vaultTitle" style="font-size:12px;color:#fff;letter-spacing:.1em">VAULT</b>
      <button type="button" class="icon-btn" data-close-modal="vaultModal" style="width:32px;height:32px;background:#111;color:#fff;border-color:#222" aria-label="Close">✕</button>
    </div>
    <div id="vaultBody" style="padding:0"></div>
  </div>
</div>

<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Cart">
  <div class="cart-panel">
    <div style="padding:16px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between">
      <b style="letter-spacing:.14em;font-size:12px"><%= t('lbl.cart') %></b>
      <button type="button" class="icon-btn" data-close-cart style="width:32px;height:32px" aria-label="Close cart">✕</button>
    </div>
    <div id="cartBody" class="cart-lines" style="padding:16px;display:grid;gap:10px;overflow:auto">
      <% if (cart.lines && cart.lines.length) { %>
      <% cart.lines.forEach(function(l){ %>
      <div class="cart-line">
        <img src="<%= l.image %>" alt=""><div><b><%= l.title %></b><span><%= yen(l.price_yen) %> × <%= l.qty %></span></div>
        <div class="cart-qty"><button type="button" data-cart-qty="<%= l.sku %>" data-value="<%= l.qty - 1 %>">−</button><b><%= l.qty %></b><button type="button" data-cart-qty="<%= l.sku %>" data-value="<%= l.qty + 1 %>">+</button></div>
        <button type="button" class="cart-x" data-cart-remove="<%= l.sku %>" aria-label="Remove">✕</button>
      </div>
      <% }) %>
      <% } else { %>
      <div class="empty"><%= lang === 'ja' ? 'カートは空です' : 'Cart empty — add some goods.' %></div>
      <% } %>
    </div>
    <div class="cart-foot">
      <div class="cart-totals"><span><%= cart.discount_label || '' %></span><b id="cartTotal"><%= cart.total_label %></b></div>
      <div class="field"><label for="pickupVenue"><%= lang === 'ja' ? '受け取り会場' : 'Pickup venue' %></label>
        <select id="pickupVenue">
          <option value="Fukuoka — TOTTEI PARK">Fukuoka — TOTTEI PARK • 09.10</option>
          <option value="Tokyo Arena">Tokyo • 09.20–23</option>
          <option value="Seoul Gocheok">Seoul • 10.18</option>
          <option value="Taipei Arena">Taipei • 11.13</option>
        </select>
      </div>
      <button type="button" class="btn primary" data-cart-checkout style="width:100%"><%= lang === 'ja' ? '注文を確定する →' : 'Confirm order →' %></button>
      <p class="fineprint"><%= lang === 'ja' ? 'メンバーのみ — QRが発行され会場で提示します。' : 'Members only — a QR is issued for venue pickup.' %></p>
    </div>
  </div>
</div>

<% /* fan-card tier payload for the live preview (data, not code) */ %>
<script type="application/json" id="tierData"><%- JSON.stringify((typeof tiers !== 'undefined' && tiers ? tiers : []).map(function(x){ return { id:x.id, name:x.name, price_label:x.price_label, accent:x.accent, rank:x.rank, perks:x.perks || [] }; })) %></script>
