<!doctype html>
<html lang="ja" class="js-adm">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Console sign-in</title>
  <meta name="robots" content="noindex,nofollow">
  <meta name="csrf-token" content="<%= csrf %>">
  <link rel="icon" type="image/png" sizes="32x32" href="/static/favicon-32.png">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/admin.css">
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <span class="pill gold mono">OFFICIAL SITE • MANAGEMENT</span>
      <h1>Management Console</h1>
      <p class="dim small">Content, fan cards, bookings, tickets, orders and the live publish channel — one login.</p>
      <% if (error) { %><div class="err" role="alert"><%= error %></div><% } %>
      <form method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div><label class="fl" for="ae">Email</label><input id="ae" name="email" type="email" value="admin@starto.jp" autocomplete="username" required></div>
        <div><label class="fl" for="ap">Password</label><input id="ap" name="password" type="password" value="Starto2026!" autocomplete="current-password" required></div>
        <button class="btn gold" type="submit" style="justify-content:center;padding:11px">Enter console →</button>
      </form>
      <p class="login-hint mono">seeded admin · admin@starto.jp / Starto2026!<br>members keep their own login on the public site</p>
    </div>
  </div>
</body>
</html>
